    }
    .academy-impact-footer-bar {
      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-radius: 6px;
      padding: 9px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11px;
      color: #334155;
      flex-shrink: 0;
    }

    /* -------------------------------------------------------------
       SLIDE 10: CLIENTS REFINED
    ------------------------------------------------------------- */
    .client-card-refined {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 8px;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      box-shadow: 0 2px 6px rgba(15, 23, 42, 0.03);
    }

    /* About-item-icon numbered clean styling */
    .about-item-icon {
      width: 32px !important;
      height: 32px !important;
      border-radius: 6px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      flex-shrink: 0 !important;
      font-weight: 800 !important;
      font-size: 12px !important;
      color: #1D4ED8 !important;
      background: #EFF6FF !important;
      border: 1px solid #BFDBFE !important;
    }
"""

style_final = style + "\n" + clean_modern_css

# Construct React component
react_file_parts = [
    'import React, { useState, useEffect, useRef } from "react";\n',
    'import { Link } from "react-router-dom";\n',
    'import {\n',
    '  ChevronLeft,\n',
    '  ChevronRight,\n',
    '  Printer,\n',
    '  Grid,\n',
    '  Monitor,\n',
    '  ArrowLeft,\n',
    '} from "lucide-react";\n\n',
    'export default function CompanyProfile() {\n',
    '  const [currentSlide, setCurrentSlide] = useState(1);\n',
    '  const [viewAll, setViewAll] = useState(false);\n',
    '  const totalSlides = 10;\n',
    '  const containerRef = useRef<HTMLDivElement>(null);\n\n',
    '  useEffect(() => {\n',
    '    const handleKeyDown = (e: KeyboardEvent) => {\n',
    '      if (viewAll) return;\n',
    '      if (e.key === "ArrowRight" || e.key === "PageDown") {\n',
    '        setCurrentSlide((prev) => Math.min(prev + 1, totalSlides));\n',
    '      } else if (e.key === "ArrowLeft" || e.key === "PageUp") {\n',
    '        setCurrentSlide((prev) => Math.max(prev - 1, 1));\n',
    '      } else if (e.key === "Home") {\n',
    '        setCurrentSlide(1);\n',
    '      } else if (e.key === "End") {\n',
    '        setCurrentSlide(totalSlides);\n',
    '      }\n',
    '    };\n',
    '    window.addEventListener("keydown", handleKeyDown);\n',
    '    return () => window.removeEventListener("keydown", handleKeyDown);\n',
    '  }, [viewAll]);\n\n',
    '  useEffect(() => {\n',
    '    if (!containerRef.current) return;\n',
    '    const sheets = containerRef.current.querySelectorAll<HTMLElement>(".sheet");\n',
    '    sheets.forEach((sheet, index) => {\n',
    '      if (viewAll) {\n',
    '        sheet.style.display = "flex";\n',
    '      } else {\n',
    '        if (index + 1 === currentSlide) {\n',
    '          sheet.style.display = "flex";\n',
    '        } else {\n',
    '          sheet.style.display = "none";\n',
    '        }\n',
    '      }\n',
    '    });\n',
    '  }, [currentSlide, viewAll]);\n\n',
    '  const handlePrint = () => {\n',
    '    window.print();\n',
    '  };\n\n',
    '  return (\n',
    '    <div className="min-h-screen bg-slate-200 text-slate-900 font-sans antialiased selection:bg-slate-900 selection:text-white print:bg-white print:p-0">\n',
    '      <style dangerouslySetInnerHTML={{ __html: ' + json.dumps(style_final) + ' }} />\n\n',
    '      {/* Floating Presentation Controls */}\n',
    '      <nav\n',
    '        aria-label="Deck controls"\n',
    '        className="no-print fixed bottom-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2 sm:gap-3 bg-slate-900/95 backdrop-blur-md text-white px-4 py-2.5 rounded-full shadow-2xl border border-slate-700 text-xs sm:text-sm font-medium"\n',
    '      >\n',
    '        <Link\n',
    '          to="/"\n',
    '          className="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors"\n',
    '          title="Return to Website"\n',
    '        >\n',
    '          <ArrowLeft className="w-4 h-4" />\n',
    '          <span className="hidden md:inline">Website</span>\n',
    '        </Link>\n\n',
    '        <div className="h-4 w-px bg-slate-700 mx-1" />\n\n',
    '        <button\n',
    '          type="button"\n',
    '          onClick={() => setCurrentSlide((prev) => Math.max(prev - 1, 1))}\n',
    '          disabled={currentSlide === 1 || viewAll}\n',
    '          className="p-1.5 rounded-full hover:bg-slate-800 disabled:opacity-40 disabled:hover:bg-transparent transition-colors"\n',
    '          title="Previous Slide"\n',
    '        >\n',
    '          <ChevronLeft className="w-4 h-4" />\n',
    '        </button>\n\n',
    '        <div className="px-2 font-mono text-slate-300 min-w-[80px] text-center">\n',
    '          {viewAll ? "All Slides" : `Page ${currentSlide} of ${totalSlides}`}\n',
    '        </div>\n\n',
    '        <button\n',
    '          type="button"\n',
    '          onClick={() => setCurrentSlide((prev) => Math.min(prev + 1, totalSlides))}\n',
    '          disabled={currentSlide === totalSlides || viewAll}\n',
    '          className="p-1.5 rounded-full hover:bg-slate-800 disabled:opacity-40 disabled:hover:bg-transparent transition-colors"\n',
    '          title="Next Slide"\n',
    '        >\n',
    '          <ChevronRight className="w-4 h-4" />\n',
    '        </button>\n\n',
    '        <div className="h-4 w-px bg-slate-700 mx-1" />\n\n',
    '        <button\n',
    '          type="button"\n',
    '          onClick={() => setViewAll(!viewAll)}\n',
    '          className={`flex items-center gap-1.5 px-3 py-1.5 rounded-full transition-colors ${\n',
    '            viewAll ? "bg-blue-600 text-white" : "bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white"\n',
    '          }`}\n',
    '          title={viewAll ? "Switch to Single Slide View" : "View All Slides"}\n',
    '        >\n',
    '          {viewAll ? <Monitor className="w-4 h-4" /> : <Grid className="w-4 h-4" />}\n',
    '          <span className="hidden sm:inline">{viewAll ? "Slide View" : "All Slides"}</span>\n',
    '        </button>\n\n',
    '        <button\n',
    '          type="button"\n',
    '          onClick={handlePrint}\n',
    '          className="flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-blue-600 hover:bg-blue-500 text-white font-semibold shadow-sm transition-colors"\n',
    '          title="Print or Save as PDF"\n',
    '        >\n',
    '          <Printer className="w-4 h-4" />\n',
    '          <span>Save PDF</span>\n',
    '        </button>\n',
    '      </nav>\n\n',
    '      {/* Main Slides Deck */}\n',
    '      <main\n',
    '        ref={containerRef}\n',
    '        className="deck-container"\n',
    '        dangerouslySetInnerHTML={{ __html: ' + json.dumps(all_10_final_slides) + ' }}\n',
    '      />\n',
    '    </div>\n',
    '  );\n',
    '}\n'
]

with open('Stalight_website/src/pages/CompanyProfile.tsx', 'w', encoding='utf-8') as f:
    f.write(''.join(react_file_parts))

print("Successfully written CompanyProfile.tsx with 6-card Campus ERP (Sync AI format) and tight Academy layout!")
