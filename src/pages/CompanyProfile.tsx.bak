    }
    .t-badge {
      font-family: var(--font-mono);
      font-size: 9.5px;
      background: #F1F5F9;
      color: #475569;
      padding: 2px 6px;
      border-radius: 3px;
      border: 1px solid #E2E8F0;
    }
    .academy-cohort-strip {
      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-radius: 6px;
      padding: 10px 14px;
      flex-shrink: 0;
    }
    .cohort-strip-tag {
      font-size: 10.5px;
      font-weight: 800;
      color: #BE123C;
      letter-spacing: 0.8px;
      text-transform: uppercase;
