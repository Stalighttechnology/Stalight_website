    }

    /* -------------------------------------------------------------
       SLIDE 9: ACADEMY RESTRUCTURED (TIGHT 2-PANEL, ZERO BLANK SPACE)
    ------------------------------------------------------------- */
    .academy-pro-layout {
      display: grid;
      grid-template-columns: 500px 1fr;
      gap: 20px;
      flex: 1;
      margin: 8px 0;
      align-items: stretch;
      overflow: hidden;
    }
    .academy-left-panel {
      display: flex;
      flex-direction: column;
      gap: 10px;
      height: 100%;
    }
    .academy-right-panel {
      display: flex;
      flex-direction: column;
      gap: 10px;
      height: 100%;
    }
    .academy-col-header-pill {
      font-family: var(--font-heading);
      font-size: 11.5px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #0F172A;
      margin-bottom: 2px;
    }
    .academy-track-box {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 8px;
      padding: 14px 16px;
      box-shadow: 0 2px 6px rgba(15, 23, 42, 0.03);
      display: flex;
      flex-direction: column;
      gap: 6px;
      flex: 1;
    }
    .track-header-line {
      display: flex;
