      color: #0F172A;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .mod-name {
      font-family: var(--font-heading);
      font-size: 12px;
      font-weight: 800;
      color: #0F172A;
    }
    .mod-desc {
      font-size: 11px;
      color: #475569;
