import subprocess
import re
import json

# Read git original base
orig = subprocess.check_output(['git', '-C', 'Stalight_website', 'show', 'HEAD:public/company-profile.html']).decode('utf-8')

style = re.search(r'<style>(.*?)</style>', orig, re.DOTALL).group(1)
body_sheets = re.search(r'<main class="deck-container">(.*?)</main>', orig, re.DOTALL).group(1)

# Clean emojis from KPI pills
body_sheets = body_sheets.replace('⚡ Sub-Second API Response (<120ms)', '<span style="font-weight:700;">Sub-Second API Response</span> (&lt;120ms)')
body_sheets = body_sheets.replace('🎯 88% Verified Placement Rate', '<span style="font-weight:700;">88%</span> Verified Placement Rate')
body_sheets = body_sheets.replace('🛡️ 99.98% SLA & Zero Breaches', '<span style="font-weight:700;">99.98% SLA</span> &amp; Zero Breaches')
body_sheets = body_sheets.replace('🛡 99.98% SLA & Zero Breaches', '<span style="font-weight:700;">99.98% SLA</span> &amp; Zero Breaches')
body_sheets = body_sheets.replace('📈 3.8x Qualified Pipeline Multiplier', '<span style="font-weight:700;">3.8x</span> Qualified Pipeline Multiplier')

# Clean Cover badge heading
body_sheets = re.sub(r'<div class="cover-badge">.*?Official Corporate Profile.*?</div>', '', body_sheets, flags=re.DOTALL)

# Clean ® symbol
body_sheets = body_sheets.replace('&reg;', '').replace('®', '')

# Helper to extract sheet
def get_sheet(n):
    m = re.search(r'(<article class="sheet[^\"]*" id="slide-' + str(n) + '".*?</article>)', body_sheets, re.DOTALL)
    return m.group(1) if m else ""

sheet_2 = get_sheet(2) # About Stalight
sheet_5 = get_sheet(5) # Stalight Sync AI Platform
sheet_10 = get_sheet(10) # Strategic Alliances

# Update Slide 2 (About)
sheet_2 = re.sub(r'<span class="slide-number-badge">.*?</span>', '<span class="slide-number-badge">02 / 10</span>', sheet_2)
sheet_2 = sheet_2.replace('<div class="about-item-icon">M</div>', '<div class="about-item-icon">01</div>')
sheet_2 = sheet_2.replace('<div class="about-item-icon">V</div>', '<div class="about-item-icon">02</div>')
sheet_2 = sheet_2.replace('<div class="about-item-icon">&hearts;</div>', '<div class="about-item-icon">03</div>')
sheet_2 = sheet_2.replace('<div class="about-item-icon">&Delta;</div>', '<div class="about-item-icon">04</div>')
sheet_2 = sheet_2.replace('<div class="about-item-icon">&infin;</div>', '<div class="about-item-icon">05</div>')
sheet_2 = sheet_2.replace('<div class="about-item-icon">&sect;</div>', '<div class="about-item-icon">06</div>')

